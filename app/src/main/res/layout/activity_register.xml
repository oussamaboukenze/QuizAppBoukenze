<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".Register">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_panel"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nouveau profil"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Completez vos informations"
                android:textColor="@color/light_green"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_surface"
            android:elevation="2dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp">

            <FrameLayout
                android:id="@+id/profileImageContainer"
                android:layout_width="118dp"
                android:layout_height="118dp"
                android:layout_marginBottom="18dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="22dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/baseline_person_28"
                    app:shapeAppearanceOverlay="@style/CircleImageView"
                    app:strokeColor="@color/stroke_soft"
                    app:strokeWidth="1dp" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabAddPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:clickable="true"
                    android:contentDescription="Ajouter une photo"
                    android:focusable="true"
                    app:backgroundTint="@color/emsi_green"
                    app:fabCustomSize="38dp"
                    app:srcCompat="@android:drawable/ic_menu_camera"
                    app:tint="@color/white" />
            </FrameLayout>

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:background="@drawable/bg_input_field"
                android:drawableStart="@drawable/baseline_person_28"
                android:drawablePadding="12dp"
                android:drawableTint="@color/emsi_green"
                android:hint="Nom complet"
                android:inputType="textPersonName"
                android:minHeight="56dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/black"
                android:textColorHint="@color/gray_text" />

            <EditText
                android:id="@+id/etMail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_input_field"
                android:drawableStart="@drawable/baseline_mail_28"
                android:drawablePadding="12dp"
                android:drawableTint="@color/emsi_green"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:minHeight="56dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/black"
                android:textColorHint="@color/gray_text" />

            <EditText
                android:id="@+id/etSchoolName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:clickable="true"
                android:drawableStart="@android:drawable/ic_menu_mylocation"
                android:drawablePadding="12dp"
                android:drawableTint="@color/emsi_green"
                android:focusable="false"
                android:hint="Campus"
                android:minHeight="56dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/black"
                android:textColorHint="@color/gray_text" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:autofillHints="newPassword"
                android:background="@drawable/bg_input_field"
                android:drawableStart="@drawable/baseline_lock_28"
                android:drawablePadding="12dp"
                android:drawableTint="@color/emsi_green"
                android:hint="Mot de passe"
                android:inputType="textPassword"
                android:minHeight="56dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/black"
                android:textColorHint="@color/gray_text" />

            <EditText
                android:id="@+id/etPassword1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:autofillHints="newPassword"
                android:background="@drawable/bg_input_field"
                android:drawableStart="@drawable/baseline_lock_28"
                android:drawablePadding="12dp"
                android:drawableTint="@color/emsi_green"
                android:hint="Confirmer le mot de passe"
                android:inputType="textPassword"
                android:minHeight="56dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/black"
                android:textColorHint="@color/gray_text" />

            <Button
                android:id="@+id/bRegister"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_button_primary"
                android:text="Creer le compte"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
